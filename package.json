{
  "name": "fieldbridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-disciplinary trend & connection engine — maps where science connects, where it doesn't, and which gaps are closing fastest.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "matrix": "tsx src/cli.ts",
    "artifact": "tsx src/artifact.ts",
    "validate": "tsx src/validate-run.ts",
    "calibrate": "tsx src/calibrate.ts",
    "benchmark": "tsx src/benchmark-run.ts",
    "benchmark:subfield": "tsx src/subfield-run.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npm run preview"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
